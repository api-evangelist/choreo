                      "mode": "raw",
                      "raw": "{\n  \"keyType\": \"PRODUCTION\",\n  \"grantTypes\": [\n    \"authorization_code\",\n    \"refresh_token\"\n  ],\n  \"callbackUrl\": \"<string>\",\n  \"validityTime\": \"<integer>\"\n}",
