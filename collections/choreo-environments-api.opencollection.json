{
  "opencollection": "1.0.0",
  "info": {
    "name": "Choreo API Management Alerts Environments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Environments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Choreo List environments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://console.choreo.dev/api/v1/organizations/:orgId/environments",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization identifier."
              }
            ]
          },
          "docs": "Retrieve a list of environments configured for the organization (e.g., Development, Staging, Production)."
        }
      ]
    }
  ],
  "bundled": true
}